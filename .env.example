# -------------------------------------------------------------------
# Copy this file to ".env" (next to docker-compose.yml) and fill in
# your real values. docker compose reads it automatically.
# Everything here is OPTIONAL for local testing — the compose file has
# working defaults. These matter for a real / server deployment.
#
# Values containing "$" MUST be wrapped in single quotes, e.g.
#   SECRET_KEY='abc$def'
# otherwise compose treats "$def" as a variable and silently cuts the value.
# -------------------------------------------------------------------

# Django
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
# Public URL of the app (email verification redirects here):
FRONTEND_URL=https://videoflix.marius-katzer.com
# Comma-separated extra hosts (your server domain / IP), no scheme:
DJANGO_ALLOWED_HOSTS=your-allowed-hosts
# Comma-separated extra CORS origins (include the scheme):
CORS_ALLOWED_ORIGINS=your-allowed-cors

# PostgreSQL (used by both the db service and Django)
DATABASE_NAME=database_videoflix
DATABASE_USER=videoflix_user
DATABASE_PASSWORD=change-me-db-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# Email (SMTP). For local testing you can leave EMAIL_BACKEND on the console
# backend (default in compose) to print emails to the backend logs instead.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
AUTHEMAIL_DEFAULT_EMAIL_FROM=no-reply@your-domain.com
AUTHEMAIL_DEFAULT_EMAIL_BCC=
AUTHEMAIL_EMAIL_HOST=smtp.your-provider.com
AUTHEMAIL_EMAIL_PORT=587
AUTHEMAIL_EMAIL_HOST_USER=your-smtp-user
AUTHEMAIL_EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
