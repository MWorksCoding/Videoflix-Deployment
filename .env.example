# -------------------------------------------------------------------
# Copy this file to ".env" (next to docker-compose.yml) and fill in
# your real values. docker compose reads it automatically.
# Everything here is OPTIONAL for local testing — the compose file has
# working defaults. These matter for a real / server deployment.
#
# Values containing "$" MUST be wrapped in single quotes, e.g.
#   SECRET_KEY='abc$def'
# otherwise compose treats "$def" as a variable and silently cuts the value.
# -------------------------------------------------------------------

# Host port the app is published on (127.0.0.1 only). The host nginx site
# must proxy_pass to the same port. Pick a free one if 8000 is taken.
APP_PORT=8030

# Django
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
# Public URL of the app, with scheme, no trailing slash (email verification redirects here):
FRONTEND_URL=https://videoflix.marius-katzer.com
# Django's ALLOWED_HOSTS: comma-separated hostnames, NO scheme, NO port.
# (127.0.0.1 is always added for the app's internal API calls.)
DJANGO_ALLOWED_HOSTS=videoflix.marius-katzer.com
# Comma-separated origins WITH scheme. Frontend and API share one origin, so
# the app's own URL is enough. Defaults to FRONTEND_URL when left empty.
CORS_ALLOWED_ORIGINS=https://videoflix.marius-katzer.com

# PostgreSQL (used by both the db service and Django).
# Postgres only applies these when its data volume is first created — changing
# them later locks Django out of the existing database.
DATABASE_NAME=database_videoflix
DATABASE_USER=videoflix_user
DATABASE_PASSWORD=change-me-db-password

# Redis (internal only, no data volume, so it is safe to change any time).
# Generate one with: openssl rand -hex 32
REDIS_PASSWORD=change-me-redis-password

# Email (SMTP). For local testing you can leave EMAIL_BACKEND on the console
# backend (default in compose) to print emails to the backend logs instead.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
AUTHEMAIL_DEFAULT_EMAIL_FROM=no-reply@your-domain.com
AUTHEMAIL_DEFAULT_EMAIL_BCC=
AUTHEMAIL_EMAIL_HOST=smtp.your-provider.com
AUTHEMAIL_EMAIL_PORT=587
AUTHEMAIL_EMAIL_HOST_USER=your-smtp-user
AUTHEMAIL_EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
